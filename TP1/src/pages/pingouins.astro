---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from '@observablehq/plot';
import penguins from '../data/penguins.json';

const penguinsOptions = {
  x: { label: 'Longueur du bec →' },
  y: { label: '↑ Épaisseur du bec' },
  marks: [
    Plot.dot(penguins, { x: 'culmen_length_mm', y: 'culmen_depth_mm', stroke: 'species' })
  ]
};
---

<Layout title="Pingouins - TP Plot">
  <main class="min-h-screen bg-rose-50 px-4 py-8 text-slate-700">
    <div class="mx-auto max-w-5xl rounded-3xl border border-rose-200 bg-white p-6 shadow-[0_12px_30px_rgba(244,114,182,0.12)] md:p-8">
      <div class="mb-6 flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-rose-500">Dataset</p>
          <h1 class="mt-2 text-3xl font-bold text-rose-900">Penguins</h1>
        </div>

        <a
          href="/"
          class="inline-flex items-center rounded-full border border-rose-200 bg-rose-100 px-4 py-2 text-sm font-semibold text-rose-700 transition hover:bg-rose-200"
        >
          Retour
        </a>
      </div>

      <figure class="overflow-hidden rounded-2xl border border-rose-100 bg-rose-50 p-3">
        <PlotFigure options={penguinsOptions} />
        <figcaption class="mt-3 text-sm text-rose-700">
          Longueur vs profondeur du bec, par espèce.
        </figcaption>
      </figure>
    </div>
  </main>
</Layout>
