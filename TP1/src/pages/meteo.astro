---
import Layout from '../layouts/Layout.astro';
import PlotFigure from '../components/PlotFigure.astro';
import * as Plot from '@observablehq/plot';
import weather from '../data/weather.json';

const weatherData = weather.map((entry) => ({
  ...entry,
  date: new Date(entry.date)
}));

const weatherOptions = {
  x: { label: 'Date', type: 'time' },
  y: { label: 'Température (°C)' },
  marks: [
    Plot.lineY(weatherData, {
      x: 'date',
      y: 'temp_max',
      stroke: '#ef4444',
      title: 'temp_max'
    }),
    Plot.lineY(weatherData, {
      x: 'date',
      y: 'temp_min',
      stroke: '#3b82f6',
      title: 'temp_min'
    })
  ]
};
---

<Layout title="Météo - TP Plot">
  <main class="min-h-screen bg-pink-50 px-4 py-8 text-slate-700">
    <div class="mx-auto max-w-5xl rounded-3xl border border-pink-200 bg-white p-6 shadow-[0_12px_30px_rgba(236,72,153,0.12)] md:p-8">
      <div class="mb-6 flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.25em] text-pink-500">Dataset</p>
          <h1 class="mt-2 text-3xl font-bold text-pink-900">Météo</h1>
        </div>

        <a
          href="/"
          class="inline-flex items-center rounded-full border border-pink-200 bg-pink-100 px-4 py-2 text-sm font-semibold text-pink-700 transition hover:bg-pink-200"
        >
          Retour
        </a>
      </div>

      <figure class="overflow-hidden rounded-2xl border border-pink-100 bg-pink-50 p-3">
        <PlotFigure options={weatherOptions} />
        <figcaption class="mt-3 text-sm text-pink-700">
          Températures maximales et minimales sur la période observée.
        </figcaption>
      </figure>
    </div>
  </main>
</Layout>
